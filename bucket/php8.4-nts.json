{
    "version": "8.4.27-1",
    "homepage": "https://windows.php.net/downloads/releases/",
    "description": "PHP 8.4 (non-thread-safe/NTS build) for Windows. Widely used open-source scripting language for web development.",
    "license": {
        "identifier": "PHP-3.01",
        "url": "https://www.php.net/license/"
    },
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "32bit": {
            "url": "https://windows.php.net/downloads/releases/php-8.4.27-1-nts-Win32-vs17-x64.zip",
            "hash": "dbae154a0a89791f36c3d48e68bae797878333e7d6cb5721e74617de59b63ab7 "
        },
        "64bit": {
            "url": "https://windows.php.net/downloads/releases/php-8.4.27-1-nts-Win32-vs17-x86.zip",
            "hash": "136209338d26807614afdaf4708cdd6fd9b7699446971bc31ef9d6dfab552c59 "
        }
    },
    "post_install": "if($bucket) { . \"$(Find-BucketDirectory $bucket\\bin\\postinstall.ps1)\" -dir \"$dir\" }",
    "env_set": {
        "PHP_INI_SCAN_DIR": "$persist_dir;$dir\\conf.d;"
    },
    "bin": [
        "php.exe",
        "php-cgi.exe"
    ],
    "persist": "conf.d",
    "checkver": {
        "url": "https://windows.php.net/download/",
        "re": "<h3 id=\"php-8.4\".*?>.*?\\(([\\d.-]+)\\)</h3>"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://windows.php.net/downloads/releases/php-$version-nts-Win32-vs17-x86.zip"
            },
            "64bit": {
                "url": "https://windows.php.net/downloads/releases/php-$version-nts-Win32-vs17-x64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/sha256sum.txt"
        }
    }
}
