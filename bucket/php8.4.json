{
    "version": "8.4.27-1",
    "homepage": "https://windows.php.net/downloads/releases/",
    "description": "PHP 8.4 (thread-safe/TS build) for Windows. Widely used open-source scripting language for web development.",
    "license": {
        "identifier": "PHP-3.01",
        "url": "https://www.php.net/license/"
    },
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "32bit": {
            "url": "https://windows.php.net/downloads/releases/php-8.4.27-1-Win32-vs17-x86.zip",
            "hash": "a1ca9dd642bc9c5bf707bbf704d57b79ac94984cdff8a17cfcf9d8565d9c917b"
        },
        "64bit": {
            "url": "https://windows.php.net/downloads/releases/php-8.4.27-1-Win32-vs17-x64.zip",
            "hash": "53db2047139bdfb8e6c7c7d5860a0a6a2a4f1dcac49fcf18ae610a14d8ccdf5b"
        }
    },
    "post_install": "if($bucket) { . \"$(Find-BucketDirectory $bucket\\bin\\postinstall.ps1)\" -dir \"$dir\" }",
    "env_set": {
        "PHP_INI_SCAN_DIR": "$persist_dir;$dir\\conf.d;"
    },
    "bin": [
        "php.exe",
        "php-cgi.exe"
    ],
    "persist": "conf.d",
    "checkver": {
        "url": "https://windows.php.net/download/",
        "re": "<h3 id=\"php-8.4\".*?>.*?\\(([\\d.-]+)\\)</h3>"
    },
    "autoupdate": {
        "hash": {
            "url": "$baseurl/sha256sum.txt"
        },
        "architecture": {
            "32bit": {
                "url": "https://windows.php.net/downloads/releases/php-$version-Win32-vs17-x86.zip"
            },
            "64bit": {
                "url": "https://windows.php.net/downloads/releases/php-$version-Win32-vs17-x64.zip"
            }
        }
    }
}
